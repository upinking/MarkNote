{
  "name": "marknote",
  "version": "0.1.0",
  "description": "A lightweight cross-platform Markdown note editor.",
  "author": "Codex",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:plugin": "node --test plugins/marknote/tests/*.test.cjs",
    "test:all": "npm test && npm run test:plugin",
    "build:assets": "node scripts/copy-markdown-vendors.cjs && node scripts/copy-katex.cjs && node scripts/copy-lucide.cjs",
    "dev": "npm run build:assets && electron .",
    "build": "electron-builder",
    "package:mac": "npm run build:assets && node scripts/package-macos.cjs",
    "start": "npm run build:assets && electron .",
    "prebuild": "npm run build:assets",
    "mobile:dev": "vite --config vite.mobile.config.mjs",
    "mobile:build": "vite build --config vite.mobile.config.mjs",
    "mobile:sync": "npm run mobile:build && cap sync android",
    "mobile:open": "cap open android"
  },
  "build": {
    "appId": "com.codex.marknote",
    "productName": "MarkNote",
    "files": [
      "app/**/*",
      "build/**/*",
      "electron/**/*",
      "plugins/marknote/**/*",
      "shared/**/*",
      "README.md",
      "package.json"
    ],
    "asarUnpack": [
      "plugins/marknote/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "dompurify": "^3.4.14",
    "katex": "^0.17.0",
    "lucide": "^1.22.0",
    "marked": "^18.0.4"
  }
}
